# ==============================================================================
# REGARDS SPORTS CLUB — ENVIRONMENT TEMPLATE FOR VERCEL DEPLOYMENT
# Copy this file to .env and configure in Vercel Project Settings > Environment Variables
# ==============================================================================

# Application & Server
NODE_ENV=production
PORT=3000
SITE_URL=https://your-project-name.vercel.app

# Store Branding
STORE_NAME="Regards Sports Club"
STORE_SHORT_NAME="RSC"
STORE_CURRENCY="BDT"
STORE_CURRENCY_SYMBOL="Tk"

# Customer Support & Hotline
SUPPORT_PHONE="+8801754724991"
SUPPORT_WHATSAPP="8801754724991"
SUPPORT_EMAIL="support@regardssportsclub.com"
SHOWROOM_ADDRESS="House #48, Road #03, Block #E, Banasree, Rampura, Dhaka-1219, Bangladesh"

# Logistics & Courier Rates (BDT)
SHIPPING_RATE_DHAKA=70
SHIPPING_RATE_OUTSIDE=120
FREE_SHIPPING_THRESHOLD=2000

# Custom Jersey Printing Surcharge (BDT)
JERSEY_PRINT_FEE=250

# Vercel Serverless Flag
VERCEL=1
