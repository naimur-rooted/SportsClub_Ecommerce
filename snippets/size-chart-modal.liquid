{% comment %}
  Accurate Size Chart for Regards Sports Club (Football Jerseys & Turf Shoes).
{% endcomment %}

<div id="size-chart-modal" style="display: none;">
  <div style="max-width: 600px; padding: 2rem;">
    <h3 style="font-family: var(--font-heading); margin-bottom: 1.5rem; text-align: center;">
      Official Sizing Guide
    </h3>

    <h4 style="margin-top: 1.5rem; font-size: 1.6rem; color: var(--color-primary);">
      1. Football Jersey Size Chart (Inches)
    </h4>
    <p style="font-size: 1.3rem; color: #666;">
      Note: Player Edition kits have an athletic, slim fit. If you prefer a looser fit, we recommend ordering one size up.
    </p>

    <table class="size-chart-table">
      <thead>
        <tr>
          <th>Size</th>
          <th>Chest (Inches)</th>
          <th>Length (Inches)</th>
          <th>Body Height</th>
          <th>Weight Range</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>M</strong></td>
          <td>38 - 40"</td>
          <td>27 - 28"</td>
          <td>5'4" - 5'7"</td>
          <td>55 - 65 kg</td>
        </tr>
        <tr>
          <td><strong>L</strong></td>
          <td>40 - 42"</td>
          <td>28 - 29"</td>
          <td>5'7" - 5'10"</td>
          <td>65 - 75 kg</td>
        </tr>
        <tr>
          <td><strong>XL</strong></td>
          <td>42 - 44"</td>
          <td>29 - 30"</td>
          <td>5'10" - 6'1"</td>
          <td>75 - 85 kg</td>
        </tr>
        <tr>
          <td><strong>2XL</strong></td>
          <td>44 - 46"</td>
          <td>30 - 31"</td>
          <td>6'0" - 6'3"</td>
          <td>85 - 95 kg</td>
        </tr>
      </tbody>
    </table>

    <h4 style="margin-top: 2.5rem; font-size: 1.6rem; color: var(--color-primary);">
      2. Turf Football Shoes Size Chart
    </h4>
    <table class="size-chart-table">
      <thead>
        <tr>
          <th>EU Size</th>
          <th>UK Size</th>
          <th>US (Men)</th>
          <th>Foot Length (CM)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>40</strong></td>
          <td>6</td>
          <td>7</td>
          <td>25.0 cm</td>
        </tr>
        <tr>
          <td><strong>41</strong></td>
          <td>7</td>
          <td>8</td>
          <td>26.0 cm</td>
        </tr>
        <tr>
          <td><strong>42</strong></td>
          <td>7.5</td>
          <td>8.5</td>
          <td>26.5 cm</td>
        </tr>
        <tr>
          <td><strong>43</strong></td>
          <td>8.5</td>
          <td>9.5</td>
          <td>27.5 cm</td>
        </tr>
        <tr>
          <td><strong>44</strong></td>
          <td>9</td>
          <td>10</td>
          <td>28.0 cm</td>
        </tr>
        <tr>
          <td><strong>45</strong></td>
          <td>10</td>
          <td>11</td>
          <td>29.0 cm</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
