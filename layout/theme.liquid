<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#D63A2F">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <title>{{ page_title }} – Regards Sports Club</title>
    <meta name="description" content="{{ page_description | default: 'Shop authentic football jerseys, player editions, turf boots and training gear at Regards Sports Club Bangladesh. Cash on delivery nationwide.' | escape }}">

    <!-- Open Graph / Social Meta -->
    <meta property="og:site_name" content="Regards Sports Club">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:type" content="website">
    <meta property="og:description" content="{{ page_description | default: 'Shop authentic football kits in Bangladesh' | escape }}">
    {% if page_image %}
      <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
    {% endif %}

    {{ content_for_header }}

    <!-- Theme Stylesheet -->
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <link rel="alternate icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  </head>

  <body>
    <a class="skip-to-content-link button visually-hidden" href="#MainContent" style="position: absolute; left: -9999px;">
      Skip to content
    </a>

    <!-- Header Section -->
    {% section 'header' %}

    <!-- Main Content Area -->
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer Section -->
    {% section 'footer' %}

    <!-- Slide-Out Cart Drawer -->
    {% section 'cart-drawer' %}

    <!-- Populated Size Chart Modal Snippet -->
    {% render 'size-chart-modal' %}

    <!-- Core Theme JavaScript -->
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
